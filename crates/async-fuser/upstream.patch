+    fn insert(&mut self, future: F) {
+        let index = if let Some(index) = self.free.pop() {
+            self.slots[index].as_mut().set(Some(future));
+            index
+        } else {
+            self.slots.push(Box::pin(Some(future)));
+            self.slots.len() - 1
